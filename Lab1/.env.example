# --- Языковой помощник (необязателен) ---------------------------------------
# Подходит любой сервис с OpenAI-совместимым API. Заготовки провайдеров:
#   openrouter  https://openrouter.ai/api/v1          (openrouter.ai/keys, есть :free модели)
#   mistral     https://api.mistral.ai/v1             (console.mistral.ai)
#   groq        https://api.groq.com/openai/v1        (console.groq.com)
#   cerebras    https://api.cerebras.ai/v1
#   together    https://api.together.xyz/v1
#
# Какой из них доступен с вашего адреса, покажет:  python tools/check_llm.py --scan
#
# 403 от эндпоинта — это не про ключ: провайдер отказывает по адресу выхода в
# сеть ещё до проверки ключа. Groq, Cerebras и Together закрыты для адресов
# дата-центров, то есть практически для любого коммерческого VPN, и смена узла
# VPN не помогает. OpenRouter и Mistral пускают с таких адресов — начинайте
# с них, если сидите через VPN.

LLM_PROVIDER=openrouter
LLM_API_KEY=
# Переопределить адрес и модель, если нужно не значение по умолчанию:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_TIMEOUT=20

# Полностью отключить помощника, даже если ключ задан
# ARACHNE_LLM=0

# Если выход в сеть идёт через локальный HTTP-прокси (некоторые VPN-клиенты)
# HTTPS_PROXY=http://127.0.0.1:8080

# --- Интерфейс ---------------------------------------------------------------
# Паук-компаньон и достижения (1 — включены, 0 — выключены)
ARACHNE_COMPANION=1

ARACHNE_HOST=127.0.0.1
ARACHNE_PORT=8000
